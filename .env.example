# ─────────────────────────────────────────────────────────────
# LumiHunter AI — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA faça commit de .env.local
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LumiHunter AI

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Somente server-side. Bypassa RLS — use apenas em rotas/jobs confiáveis.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic (Claude API) ──────────────────────────────────
# Sem ANTHROPIC_API_KEY (ou com AI_DEMO_MODE=true) os agentes rodam em MODO DEMO:
# respostas simuladas realistas, custo zero — ótimo para testar antes de contratar.
AI_DEMO_MODE=
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Modelos usados pelos agentes
ANTHROPIC_MODEL_HUNTER=claude-sonnet-5
ANTHROPIC_MODEL_COPYWRITER=claude-sonnet-5
ANTHROPIC_MODEL_ANALYST=claude-sonnet-5

# ── WhatsApp Cloud API (Meta) — opcional nesta fase ─────────
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=lumihunter-verify

# ── Resend (e-mail) — opcional nesta fase ──────────────────
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=contato@seudominio.com.br
RESEND_WEBHOOK_SECRET=

# ── Busca web para o agente Hunter — opcional ─────────────
# Provedor de busca (serper | tavily | mock). "mock" gera dados sintéticos.
HUNTER_SEARCH_PROVIDER=mock
SERPER_API_KEY=
TAVILY_API_KEY=

# ── Google OAuth (configurar no Supabase Auth) ────────────
# Não precisa de var aqui; configure em Supabase > Authentication > Providers

# ── Stripe (preparado, cobrança não implementada) ─────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
